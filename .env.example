# Shopify Admin API (custom app on a development store)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=

# PayPal Orders v2 (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Postgres (Render or local)
DATABASE_URL=postgres://user:password@localhost:5432/agent_ready_store

# LLM (OpenAI-compatible chat completions with tool calling)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Public URL of this app (used for PayPal return/cancel URLs)
APP_URL=http://localhost:3000

# Optional: protect the MCP endpoint with a bearer token
MCP_BEARER_TOKEN=

# FX display/reference rates (Frankfurter, backed by ECB data)
FX_PROVIDER_URL=https://api.frankfurter.app
FX_CACHE_TTL_SECONDS=900
FX_BASE_CURRENCY=USD

# Publishing is disabled on production unless explicitly reviewed and enabled.
CATALOG_PUBLISH_ENABLED=false
