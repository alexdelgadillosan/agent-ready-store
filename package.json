{
  "name": "omnibuy-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Verified autonomous commerce: real Shopify products, explainable decisions and PayPal Sandbox checkout.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "verify": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify.mjs",
    "validate:catalog-hub": "node scripts/validate-catalog-hub.mjs",
    "test:catalog-hub": "node --import tsx scripts/test-catalog-hub.ts",
    "test:reservations": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/test-reservations.ts",
    "test:fx": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/test-fx.ts",
    "catalog:fetch:gymshark": "node scripts/fetch-gymshark-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "mcp-handler": "^2.3.1",
    "next": "^15.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
