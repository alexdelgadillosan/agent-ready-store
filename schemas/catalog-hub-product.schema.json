{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog-hub.example.invalid/schemas/product-import-v1.json",
  "title": "Catalog Hub product import (v1)",
  "description": "Portable, non-Shopify import contract. A record is a product and its variants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture", "product"],
  "properties": {
    "schema_version": { "const": "catalog-hub.product.v1" },
    "fixture": {
      "type": "boolean",
      "description": "Set true only for test fixtures. Production imports must set this to false."
    },
    "product": { "$ref": "#/$defs/product" }
  },
  "$defs": {
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "record_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "$ref": "#/$defs/url" },
        "record_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "$ref": "#/$defs/url" },
        "attribution": { "type": "string", "maxLength": 500 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "alt", "license"],
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sku", "original_price", "currency", "inventory"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
        "sku": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
        "title": { "type": "string", "maxLength": 200 },
        "original_price": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
        "currency": { "$ref": "#/$defs/currency" },
        "inventory": { "type": "integer", "minimum": 0 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source", "license", "images", "variants"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 10000 },
        "source": { "$ref": "#/$defs/source" },
        "license": { "$ref": "#/$defs/license" },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" }, "maxItems": 50 },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      }
    }
  }
}
